# Postgres connection. Locally, "npm run db" starts one on port 5433.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/plg
# Long random string used to sign logins
PAYLOAD_SECRET=change-me
# Public address of the website (canonical links, sitemap, robots.txt, share images, live preview,
# and the CMS's CSRF/CORS allow-list). Fixed into the build: set it before `npm run build`.
# In production the app stops at start-up if it is missing, and also if it is still localhost
# while a hosting integration (S3_BUCKET, CLOUDFRONT_DISTRIBUTION_ID, SMTP_HOST) is switched on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines: "off" on staging/test sites = robots.txt disallows everything, every page says
# noindex and every response carries X-Robots-Tag: noindex. Leave empty on the live site.
# Read at build time: set it before `npm run build`.
SITE_INDEXING=
# Random string protecting the preview route
PREVIEW_SECRET=change-me

# Accounts created by "npm run seed" (local development only)
SEED_ADMIN_EMAIL=admin@plg.test
SEED_ADMIN_PASSWORD=change-me
SEED_EDITOR_EMAIL=editor@plg.test
SEED_EDITOR_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Production integrations (docs/hosting-architecture.md). All optional:
# leave empty locally; each one switches on when its variable is set.
# ---------------------------------------------------------------------------

# Media storage: Amazon S3 (me-central-1). Unset = files saved in web/media/
S3_BUCKET=
S3_REGION=me-central-1
S3_PREFIX=media
# Only outside AWS; on EC2 the instance IAM role provides credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services other than AWS (e.g. MinIO, R2)
S3_ENDPOINT=
# Public CDN address for media (CloudFront in front of the bucket), e.g. https://media.example.com
MEDIA_PUBLIC_URL=

# CDN refresh on publish: CloudFront distribution in front of the site
CLOUDFRONT_DISTRIBUTION_ID=

# Email (e.g. Amazon SES SMTP). Unset = emails are printed to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=PLG Acachet
